/*** ^^A -*-C++-*- **********************************************/
/*  ta_acqu     2021-01                                         */
/****************************************************************/
/*  Short Description :                                         */
/*  Acquisition AU program for nD NUS spectra for TA            */
/*  First AUNMP ta_proc with argumnets is set                   */
/*  Acquisition starts with ZG, after that TAnD starts          */
/****************************************************************/
/*  Keywords :                                                  */
/*  2D, 3D, NUS, TA                                             */
/****************************************************************/
/*  Description/Usage :                                         */
/*  AU program to start TA on nD spectra                        */
/*  TA starts only if FnTYPE is be set to NUS                   */
/*                                                              */
/*  Arguments (same as for ta_proc:                             */
/*  -au      AU program for processing.                         */
/*           Default (2D) proc_2d or proc_2d_xf2m               */
/*                   (nD) ftnd;projcmd projdm 4 td-4 898        */
/*                   (NOAH) proc_noah3d                         */
/*  -projdim f13 or f23 for 3D spectra                          */
/*  -projcmd sumpl or projplp for 3D spectra                    */
/*  -pl      1..1TD plane to be analyzed for pseudo-nD spectra  */
/*  -procno  procno for 2D plane of nD experiment, default 898  */
/*  -xf2m    Use proc_2d_xf2m for magnitude mode spectra        */
/*  -nove    Don't use VE for FnMODE QF/States (for NOAH3D)     */
/****************************************************************/
/*  Author(s) :                                                 */
/*  Name    : Maksim Mayzel                                     */
/*  Email   : maksim.mayzel@bruker.com                          */
/****************************************************************/
/*  Name    Date    Modification:                               */
/*  MAY    202101   created                                     */
/*  MAY    202109   check ta.lock, restore procpar              */
/*	alexander.herbig	220329	changed SWH from float into double */
/****************************************************************/

AUERR = ta_acqu(curdat);
QUIT

void set_procparam(const char* curdat, int ndim, int nove);
void restore_procparam(const char* curdat, int ndim);

static int next_pow2(unsigned int);
#define XPY2(name) \
  {sprintf(Hilfs_string, "%s %s %s", "sendgui clientid=local", "xpy", name); \
  SETCURDATA AUERR=CPR_exec(Hilfs_string,WAIT_START);}   

int ta_acqu(const char* curdat)
{
  int fntype=0,taFlg=0;
  char rgacmd[512], pulprog[128];
  int     td1, qf;
  double  swh1;

  FETCHPAR("PULPROG", pulprog)
  FETCHPAR1("TD", &td1)
  FETCHPAR1("SWH", &swh1)
  FETCHPAR1("FnMODE", &qf)

  if (!strncmp(pulprog, "cosygpmf",8))
  {
      if (isHypercomplexFnmode(qf) > 0)
          qf = 2;
      else
          qf = 1;
      sprintf(rgacmd, "rga -setD0=%f", td1/(swh1*2*qf));
  }
  else if ((!strncmp(pulprog, "mlev", 4)) ||
           (!strncmp(pulprog, "dipsi",5)) ||
           (!strncmp(pulprog, "roesy",5)))
  {
      sprintf(rgacmd, "rga -setD0=%f", 1./swh1);
  }
  else
  {
      sprintf(rgacmd, "rga");
  }

  FETCHPAR("FnTYPE", &fntype);
  if (fntype!=2)
  {

    XCMD(rgacmd)
    ZG
    return 0;
  }

	if( access( ACQUPATH("ta.lock"), F_OK ) == 0 ) {
	  STOPMSG("ta.lock file is found in the current expn - TAnD.py is already running")
	  return 1;
	}

  int i, procno2d=898, plane=1, projdim=13, xf2m=0,ndim=0;
  int def_plane=plane, def_projdim=projdim, def_procno2d=procno2d;
  char proc_au[PATH_MAX], projcmd[PATH_MAX], def_projcmd[PATH_MAX];
  char aunmp[128], aunmp2[128]="ta_proc", tacmd[PATH_MAX], talock[PATH_MAX];
  int ds=isDataStation();
  int nove=0;

  if ( ds )
    strcpy(tacmd,"TAnD sim");
  else
    strcpy(tacmd,"TAnD ta");
    
  strcpy(projcmd, "sumpl");
  strcpy(def_projcmd, "sumpl");
  strcpy(proc_au, "no");

  /***** get input *****/
  for (i=2; i<i_argc; i++)
  {
    if ( strcmp(i_argv[i],"-projdim") == 0 )
        projdim=atoi(i_argv[++i]);
    if ( strcmp(i_argv[i],"-projcmd") == 0 )
        strcpy(projcmd,i_argv[++i]);
    if ( strcmp(i_argv[i],"-au") == 0 )
        strcpy(proc_au,i_argv[++i]);
    if ( strcmp(i_argv[i],"-pl") == 0 )
        plane=atoi(i_argv[++i]);
    if ( strcmp(i_argv[i],"-procno") == 0 )
        procno2d=atoi(i_argv[++i]);
    if ( strcmp(i_argv[i],"-xf2m") == 0 )
        xf2m=1;
    if ( strcmp(i_argv[i],"-nove") == 0 )
        nove=1;
  } 

  for (i=2; i<i_argc; i++)
  {
    if ( strcmp(i_argv[i],"xaua") == 0 )
      continue;
      sprintf(tacmd,"%s %s ",tacmd,i_argv[i]);
  }
  
  FETCHPAR("AUNMP",&aunmp);
  FETCHPARS( "PARMODE", &ndim);
  ndim+=1;  

  set_procparam(curdat, ndim, nove);

  /* set AUNMP program for ta_proc                                                              */
  /* if no AUNMP provided                                                                       */
  /* for 2D use proc_2d or proc_2d_xf2m                                                         */
  /* for NOAH, if AUNMP==proc_noah3d use it for ta_proc                                         */
  /* for 3D ta_proc will do ftnd + projection or plane extraction for pseudo nD                 */
  if (strcmp(proc_au,"no") == 0)
  {
    sprintf(aunmp2,"ta_proc");
    if (ndim==2)
    {
      if (xf2m || strstr(aunmp, "xf2m")) sprintf(aunmp2,"ta_proc -au proc_2d_xf2m");
      else sprintf(aunmp2,"ta_proc -au proc_2d");
    }
    else // for 3D, if AUNMP==proc_noah3d use it for ta_proc
    {
      if (strstr(aunmp, "proc_noah3d")) sprintf(aunmp2,"ta_proc -au proc_noah3d");
    }
  }
  else
  {
    sprintf(aunmp2,"ta_proc -au %s",proc_au);
  }

  /* for 3D set expn for 2D projection, proj command, orientation, plane extraction for pseudo nD*/
  if (ndim>2)
  {
    if (procno2d!=def_procno2d)
      sprintf(aunmp2,"%s -procno2d %d",aunmp2,procno2d);
    if (plane!=def_plane)
      sprintf(aunmp2,"%s -pl %d ",aunmp2,plane);
    if (strcmp(projcmd,def_projcmd))
      sprintf(aunmp2,"%s -projcmd %d ",aunmp2,projcmd);
    if (projdim!=def_projdim)
      sprintf(aunmp2,"%s -projdim %d ",aunmp2,projdim);
  }  

  // if (strstr(aunmp, "ta_proc") == 0 ) // replace AUNMP if it is not already set to ta_proc
  STOREPAR("AUNMP", aunmp2);
  XPY2(tacmd);
  sleep(1);

  if ( !ds )
    {
      XCMD(rgacmd)
      ZG
    }

  strcpy(talock, ACQUPATH("ta.lock"));
  while ( access(talock, F_OK) == 0)
  {
    sleep(2);
  }

  if (ndim==2)
    restore_procparam(curdat, ndim);
  else
    STOREPAR("AUNMP", aunmp) // restore AUNMP program

  return 0;
}

void set_procparam(const char* curdat, int ndim, int nove)
{
  int i, td, fnmode, si, stsr, stsi;
  double c;
  
  if ( ndim>3 ) 
  {
    Proc_err(DEF_ERR_OPT,"ta_proc is not yet implemented for 4D spectra");
    ERRORABORT
  } 

  XCMD("checkout_license TOPSPIN_NUS")
  if (AUERR < 0) 
  {
    STOREPAR("Mdd_CsVE", 0)
    if (ndim>2) 
    {
      Proc_err(DEF_ERR_OPT, "NUS license is required for nD processing");
      ERRORABORT
    }
  }

  FETCHPARN(1, "FnMODE", &fnmode) // set VE FALSE for QF
  if (fnmode==1 || nove==1 )
    STOREPAR("Mdd_CsVE", 0)

  if ( ndim==2 )
  {
    STOREPAR("Mdd_mod", 1)
    //STOREPAR("Mdd_CsALG", 1)
  } 
  else
  {
    if (fnmode==7)
      STOREPAR("Mdd_mod", 0)
  }

  // backup processing parameters
  WRP(100);

  FETCHPARN(ndim, "TD", &td);
  STOREPARN(ndim, "SI", next_pow2(td));
  STOREPARN(ndim, "STSR", 0);
  STOREPARN(ndim, "STSI", 0);
  for( i = 1; i < ndim; i++ )
  {
    FETCHPARN(i, "TD", &td);
    si=next_pow2(td);
    FETCHPARN(i, "FnMODE", &fnmode);
    if ( fnmode != 7 && si < 128) // set minimum SI to 128
        si=128;
    STOREPARN(i, "SI",si);
    STOREPARN(i, "MddCEXP", 0);
    STOREPARN(i, "ME_mod", 0);
  }
}

void restore_procparam(const char* curdat, int ndim)
{
  int i, td, fnmode, si, si2;

  RPROCNO(100);
  for( i = 1; i <= ndim; i++ )
  {
    FETCHPARN(i, "TD", &td);
    FETCHPARN(i, "SI", &si);
    si2=next_pow2(td);
    FETCHPARN(i, "FnMODE", &fnmode);
    if ( fnmode != 7 && si2 < 128) // set minimum SI to 128
        si2=128;
    if ( si2 > si )
        STOREPARN(i, "SI",si2);
  }
  WRP(1);
  RPROCNO(1);
  DELETEPROCNO(name, expno, 100, disk, user);
}

void rgazg(const char *curdat)
{
    char text[512], pulprog[128];
    int     td1, qf;
    double  swh1;

    FETCHPAR("PULPROG", pulprog)
    FETCHPAR1("TD", &td1)
    FETCHPAR1("SWH", &swh1)
    FETCHPAR1("FnMODE", &qf)

    if (!strncmp(pulprog, "cosygpmf",8))
    {
        if (isHypercomplexFnmode(qf) > 0)
            qf = 2;
        else
            qf = 1;

        sprintf(text, "rga -setD0=%f", td1/(swh1*2*qf));
    }
    else if ((!strncmp(pulprog, "mlev", 4)) ||
             (!strncmp(pulprog, "dipsi",5)) ||
             (!strncmp(pulprog, "roesy",5)))
    {
        sprintf(text, "rga -setD0=%f", 1./swh1);
    }
    else
    {
        sprintf(text, "rga");
    }

    XCMD(text)

    ZG
    ERRORABORT
}

static int next_pow2(unsigned int v)
{
    /* compute the next highest power of 2 of 32-bit v */ 
    v--; 
    v |= v >> 1;
    v |= v >> 2;
    v |= v >> 4;
    v |= v >> 8;
    v |= v >> 16;
    v++; 
    return v;
}
